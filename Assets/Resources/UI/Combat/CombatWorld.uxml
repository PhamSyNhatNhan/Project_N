<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="world-root" class="world-root">
    <ui:VisualElement name="enemy-vitals" class="enemy-vitals">
      <ui:VisualElement name="enemy-buffs" class="enemy-buffs" picking-mode="Ignore" />
      <ui:VisualElement name="enemy-hp-ring" class="enemy-hp-ring">
        <ui:ProgressBar name="enemy-hp" title="" class="hp enemy-hp" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="ability-grid" class="ability-grid" />
  </ui:VisualElement>
</ui:UXML>
