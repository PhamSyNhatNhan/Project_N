.pn-panel-surface { background-color: rgba(184,192,196,0.97); }
.menu-safe-area { position: absolute; top: 0; right: 0; }
.pause-toggle { position: absolute; top: 12px; right: 12px; width: 56px; height: 56px; border-width: 0; background-color: transparent; align-items: center; justify-content: center; padding: 0; }
.pause-toggle:hover { background-color: transparent; }
.pause-toggle:active { background-color: transparent; }
.pause-toggle:focus { border-width: 0; }
.pause-sparkle-icon { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.pause-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; justify-content: center; }
.pause-surface { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; }
.pause-system { position: absolute; width: 600px; height: 600px; overflow: visible; }
.pause-core { border-radius: 129px; border-width: 1px; border-color: rgba(255,255,255,0.65); overflow: hidden; }
.pause-sky { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.pause-card { position: absolute; width: 300px; height: 246px; top: 50%; right: 9%; padding: 0; background-color: transparent; justify-content: center; overflow: visible; }
.pause-choice { height: 64px; min-height: 64px; margin: 9px 0; border-width: 1px; border-color: rgba(255,255,255,0.7); border-radius: 17px; background-color: rgb(240,243,244); color: rgb(53,69,77); font-size: 20px; -unity-text-align: middle-left; padding-left: 24px; overflow: visible; }
.pause-button-halo { position: absolute; left: -4px; right: -4px; top: -4px; bottom: -4px; }
.pause-primary { background-color: rgb(248,250,250); -unity-font-style: normal; }
.pause-primary:hover { background-color: white; }
.pause-primary:active { background-color: rgb(231,238,240); }
.pause-primary:focus { border-color: white; }
.pause-choice:disabled { color: rgb(146,157,162); background-color: rgb(240,243,244); opacity: 1; }
.combat-hud { flex-grow: 1; }
.player-hud { position: absolute; left: 24px; top: 24px; flex-direction: row; align-items: center; width: 280px; }
.player-hud .portrait-host { width: 56px; height: 56px; flex-shrink: 0; margin-right: 14px; }
.player-hud .portrait-outer-ring { position: absolute; left: -3px; right: -3px; top: -3px; bottom: -3px; border-width: 1px; border-color: rgba(255,255,255,0.45); border-radius: 31px; }
.player-hud .portrait { width: 56px; height: 56px; border-width: 2px; border-color: rgba(255,255,255,0.92); border-radius: 28px; overflow: hidden; justify-content: center; align-items: center; }
.player-hud .portrait-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.player-hud .portrait-placeholder { width: 40px; height: 40px; align-items: center; justify-content: flex-end; }
.player-hud .portrait-head { width: 13px; height: 13px; border-radius: 7px; background-color: rgba(255,255,255,0.8); margin-bottom: 3px; }
.player-hud .portrait-shoulders { width: 30px; height: 20px; border-top-left-radius: 15px; border-top-right-radius: 15px; background-color: rgba(255,255,255,0.8); }
.player-hud .vitals { width: 210px; height: 52px; flex-shrink: 0; }
.player-hud .hud-health { height: 14px; flex-shrink: 0; }
.hp { height: 24px; }
.hp .unity-progress-bar__background { background-color: rgb(40,48,56); border-radius: 3px; }
.hp .unity-progress-bar__progress { background-color: rgb(102,196,163); border-radius: 3px; }
.hp .unity-progress-bar__title { color: rgb(243,249,250); font-size: 12px; -unity-font-style: bold; }
.player-hud .hp { height: 14px; margin: 0; padding: 0; overflow: hidden; border-radius: 7px; }
.player-hud .hp .unity-progress-bar__container { min-height: 0; height: 14px; }
.player-hud .hp .unity-progress-bar__background { background-color: rgba(255,255,255,0.12); border-width: 1px; border-color: rgba(255,255,255,0.25); border-radius: 7px; }
.player-hud .hp .unity-progress-bar__progress { background-color: rgb(255,255,255); border-width: 0; border-radius: 7px; top: 0; bottom: 0; left: 0; }
.player-hud .hp .unity-progress-bar__title-container { display: none; }
.player-hud .hud-buffs { position: absolute; top: 22px; left: 0; }
.player-hud .hud-buff { width: 30px; height: 30px; margin-right: 8px; flex-shrink: 0; opacity: 0.55; -unity-background-scale-mode: scale-to-fit; }
.player-hud .hud-buff-shield { background-image: resource("Effects/Shield/Shield"); }
.player-hud .hud-buff-burn { background-image: resource("Effects/Burn/Burn"); }
.player-hud .hud-buff-poison { background-image: resource("Effects/Poison/Poison"); }
.buffs { flex-direction: row; justify-content: flex-start; margin-top: 7px; align-items: center; }
.buff-caption { color: rgb(131,147,167); font-size: 10px; margin-right: 8px; }
.buff-slot { color: rgb(113,131,154); font-size: 14px; width: 21px; height: 21px; background-color: rgba(46,59,74,0.65); margin-right: 5px; -unity-text-align: middle-center; border-radius: 3px; }
.test-panel { position: absolute; right: 24px; top: 80px; width: 340px; max-height: 85%; padding: 8px; border-radius: 18px; border-width: 1px; border-color: rgba(255,255,255,0.7); overflow: hidden; }
.test-panel Button { background-color: rgba(255,255,255,0.55); color: rgb(28,33,37); height: 32px; margin: 0; border-width: 0; border-radius: 12px; font-size: 12px; }
.test-panel Button:hover { background-color: rgba(255,255,255,0.75); }
.test-panel Button:active { background-color: rgba(255,255,255,0.95); }
.test-body { padding-top: 10px; min-height: 0; flex-shrink: 1; }
.test-body Label { color: rgb(28,33,37); font-size: 12px; white-space: normal; margin: 0; }
#test-entity { margin: 0 0 10px 0; flex-shrink: 0; }
#test-entity .unity-base-field__label { min-width: 48px; color: rgb(65,73,79); }
#test-entity .unity-base-field__input { background-color: rgba(255,255,255,0.55); border-width: 0; border-radius: 9px; min-height: 28px; padding: 3px 8px; }
.test-body .unity-base-popup-field__text { color: rgb(28,33,37); }
.test-body .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(65,73,79); }
.test-section { padding: 10px; margin-bottom: 8px; border-radius: 12px; background-color: rgb(250,251,252); flex-shrink: 0; }
.test-body .test-heading { color: rgb(65,73,79); font-size: 11px; -unity-font-style: bold; margin-bottom: 7px; }
#test-scroll { max-height: 560px; min-height: 0; flex-shrink: 1; }
.unity-scroll-view .unity-scroller--vertical { width: 4px; min-width: 4px; max-width: 4px; margin-left: 6px; margin-right: 0; background-color: transparent; border-width: 0; }
.unity-scroll-view .unity-repeat-button { display: none; }
.unity-scroll-view .unity-scroller__slider { margin: 0; padding: 0; min-width: 0; background-color: transparent; border-width: 0; }
.unity-scroll-view .unity-base-slider__input { min-width: 0; background-color: transparent; background-image: none; border-width: 0; padding: 0; }
.unity-scroll-view .unity-base-slider__dragger-border { display: none; }
.unity-scroll-view .unity-base-slider__tracker { background-color: transparent; background-image: none; border-width: 0; }
.unity-scroll-view .unity-base-slider__dragger { width: 4px; min-width: 4px; max-width: 4px; left: 0; right: 0; margin: 0; background-color: rgba(255,255,255,0.9); background-image: none; border-width: 0; border-radius: 2px; }
.unity-scroll-view .unity-scroller--horizontal { display: none; }
.world-root { width: 260px; align-items: center; }
.world-name { color: rgb(238,226,195); background-color: rgba(13,20,29,0.8); border-radius: 3px; font-size: 12px; -unity-font-style: bold; padding: 2px 8px; margin-bottom: 5px; }
.enemy-world { width: 96px; height: 100%; justify-content: flex-end; }
.enemy-vitals { width: 200px; flex-shrink: 0; align-items: center; }
.enemy-buffs { flex-direction: row; flex-wrap: wrap-reverse; align-content: flex-start; justify-content: flex-start; margin-bottom: 4px; }
.enemy-buff { width: 30px; height: 30px; margin-right: 3px; flex-shrink: 0; opacity: 0.75; -unity-background-scale-mode: scale-to-fit; }
.enemy-buff-shield { background-image: resource("Effects/Shield/Shield"); }
.enemy-buff-burn { background-image: resource("Effects/Burn/Burn"); }
.enemy-buff-poison { background-image: resource("Effects/Poison/Poison"); margin-right: 0; }
.enemy-hp-ring { width: 96px; height: 14px; padding: 2px; border-width: 1px; border-color: rgba(255,255,255,0.45); border-radius: 7px; background-color: transparent; flex-shrink: 0; }
.enemy-world .enemy-hp-ring { border-color: rgba(255,180,180,0.8); }
.enemy-hp { width: 90px; height: 8px; margin: 0; padding: 0; overflow: hidden; border-radius: 4px; flex-shrink: 0; }
.enemy-hp .unity-progress-bar__background { background-color: rgba(255,255,255,0.12); border-width: 1px; border-color: rgba(255,255,255,0.25); border-radius: 4px; }
.enemy-hp .unity-progress-bar__progress { background-color: white; border-width: 0; border-radius: 4px; margin: 0; top: 0; bottom: 0; left: 0; }
.enemy-hp .unity-progress-bar__title-container { display: none; }
.player-world { height: 100%; justify-content: flex-end; }
.ability-grid { flex-direction: row; flex-wrap: wrap-reverse; justify-content: flex-start; align-content: flex-start; width: 180px; }
.ability-card { width: 35px; height: 35px; margin: 2px 5px; padding: 0; flex-shrink: 0; background-color: transparent; border-width: 0; }
.ability-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.ability-number-badge { position: absolute; padding: 1px 3px; min-width: 16px; }
.ability-card Label { margin: 0; padding: 0; font-size: 16px; color: white; -unity-font-style: bold; -unity-text-outline-width: 0; }
.ability-number-badge.ability-charge { right: 100%; margin-right: -15px; bottom: 1px; }
.ability-number-badge.ability-counter { left: 100%; margin-left: -15px; top: 1px; }
.ability-number-badge.ability-time { left: 100%; margin-left: -15px; bottom: 1px; }
.ability-card Label.ability-charge { -unity-text-align: middle-right; }
.ability-card Label.ability-counter, .ability-card Label.ability-time { -unity-text-align: middle-left; }
.enemy-hp .unity-progress-bar__container { min-height: 0; height: 8px; }
.buff-grid { position: relative; flex-shrink: 0; overflow: visible; }
.buff-card { position: absolute; width: 30px; height: 30px; background-color: transparent; border-width: 0; overflow: visible; }
.buff-glow { position: absolute; left: -3px; right: -3px; top: -3px; bottom: -3px; -unity-background-scale-mode: scale-to-fit; }
.buff-image { position: absolute; left: 3px; right: 3px; top: 3px; bottom: 3px; -unity-background-scale-mode: scale-to-fit; }
.buff-card Label { margin: 0; padding: 0; height: 16px; font-size: 14px; color: white; -unity-font-style: bold; -unity-text-outline-width: 0; }
.buff-card .ability-number-badge { padding: 0px 3px; }
.buff-card .buff-corner-0 { right: 100%; margin-right: -8px; top: -2px; }
.buff-card .buff-corner-1 { left: 100%; margin-left: -8px; top: -2px; }
.buff-card .buff-corner-2 { right: 100%; margin-right: -8px; bottom: -2px; }
.buff-card .buff-corner-3 { left: 100%; margin-left: -8px; bottom: -2px; }
.buff-corner-0 Label, .buff-corner-2 Label { -unity-text-align: middle-right; }
.buff-corner-1 Label, .buff-corner-3 Label { -unity-text-align: middle-left; }
.mobile-controls, .mobile-safe-area { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.mobile-move-zone { position: absolute; left: 0; top: 0; bottom: 0; width: 50%; }
.mobile-stick { position: absolute; width: 140px; height: 140px; border-radius: 70px; border-width: 1px; border-color: rgba(255,255,255,0.75); background-color: rgba(255,255,255,0.18); overflow: visible; }
.mobile-thumb { position: absolute; left: 44px; top: 44px; width: 50px; height: 50px; border-radius: 25px; background-color: rgba(255,255,255,0.65); border-width: 1px; border-color: rgba(255,255,255,0.9); }
.mobile-buttons { position: absolute; right: 12px; bottom: 12px; width: 500px; height: 320px; transform-origin: right bottom; }
.mobile-button { position: absolute; border-radius: 100px; border-width: 1px; border-color: rgba(255,255,255,0.75); background-color: rgba(255,255,255,0.20); overflow: visible; }
.mobile-direction-ring { position: absolute; left: -31px; top: -31px; width: 200px; height: 200px; transform-origin: center; }
.mobile-outer-ring { position: absolute; left: -5.5px; right: -5.5px; top: -5.5px; bottom: -5.5px; border-radius: 100px; border-width: 1.5px; border-color: rgba(255,255,255,0.45); background-color: transparent; }
.mobile-button-icon { position: absolute; left: 16%; right: 16%; top: 16%; bottom: 16%; opacity: 1; }
.mobile-button.mobile-pressed { background-color: rgba(255,255,255,0.35); border-color: white; }
.pc-controls { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.pc-action-cluster { position: absolute; right: 22px; bottom: 24px; width: 430px; height: 430px; transform-origin: right bottom; }
.pc-action-button { width: 60px; height: 60px; background-color: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.44); transition-property: background-color, border-color, scale; transition-duration: 0.14s; }
.pc-action-button > .mobile-outer-ring { border-width: 1px; border-color: rgba(255,255,255,0.19); }
.pc-action-button.mobile-pressed { scale: 0.94 0.94; }
.pc-action-icon { position: absolute; left: 22.8%; right: 22.8%; top: 22.8%; bottom: 22.8%; }
.pc-action-binding { position: absolute; width: 20px; height: 20px; padding: 0; margin: 0; border-width: 0.6px; border-color: rgba(255,255,255,0.7); border-radius: 4px; color: white; -unity-text-align: middle-center; font-size: 13px; text-shadow: 0 0 3px rgba(30,40,52,0.95); }

/* Roguelite flow UI: mode button, room browser, lobby, notices. Follows the pause-menu palette. */
.pn-mode-toggle { position: absolute; top: 18px; right: 76px; height: 44px; min-height: 44px; padding: 0; width: 108px; -unity-text-align: middle-center; margin: 0; border-width: 1px; border-color: rgba(255,255,255,0.95); border-radius: 22px; overflow: visible; background-color: rgb(248,250,250); color: rgb(53,69,77); font-size: 18px; }
.pn-character-toggle { position: absolute; top: 12px; right: 72px; width: 56px; height: 56px; border-width: 0; background-color: transparent; align-items: center; justify-content: center; padding: 0; margin: 0; display: none; }
.pn-character-toggle:hover { background-color: transparent; }
.pn-character-toggle:active { background-color: transparent; }
.pn-character-toggle:focus { border-width: 0; }
.pn-character-icon { width: 40px; height: 40px; -unity-background-scale-mode: scale-to-fit; }
.pn-flow-panel { position: absolute; width: 440px; padding: 22px 24px; border-width: 1px; border-color: rgba(255,255,255,0.7); border-radius: 22px; }
.pn-mode-panel { left: 50%; top: 50%; translate: -50% -50%; max-height: 90%; }
/* Lobby: party column on the left, one action at the bottom centre in the pause buttons' look. */
.pn-lobby-team { position: absolute; left: 24px; top: 50%; translate: 0 -50%; width: 220px; }
.pn-lobby-row { flex-direction: row; align-items: center; margin: 0 0 22px 0; }
.pn-lobby-avatar-host { width: 48px; height: 48px; flex-shrink: 0; margin-right: 16px; }
.pn-lobby-avatar-ring { position: absolute; left: -4px; right: -4px; top: -4px; bottom: -4px; border-width: 1px; border-color: rgba(255,255,255,0.5); border-radius: 28px; }
.pn-lobby-avatar { width: 48px; height: 48px; border-width: 2px; border-color: rgba(255,255,255,0.92); border-radius: 24px; background-color: rgba(120,128,134,0.55); overflow: hidden; -unity-background-scale-mode: scale-and-crop; align-items: center; justify-content: center; }
.pn-lobby-avatar-star { position: absolute; left: 0; right: 0; top: 0; bottom: 0; scale: 1.7 1.7; }
.pn-lobby-text { width: 104px; flex-shrink: 0; }
.pn-lobby-mark { width: 22px; height: 24px; margin-left: 12px; flex-shrink: 0; }
.pn-lobby-name { color: white; font-size: 16px; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 0 3px rgba(30,40,52,0.95); }
.pn-lobby-status { color: rgba(255,255,255,0.88); font-size: 13px; margin: 2px 0 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 0 3px rgba(30,40,52,0.95); }
.pn-lobby-action { position: absolute; left: 50%; bottom: 36px; width: 260px; translate: -50% 0; margin: 0; padding-left: 0; -unity-text-align: middle-center; }
.pn-flow-title { color: rgb(53,69,77); font-size: 26px; -unity-font-style: bold; margin-bottom: 12px; -unity-text-align: middle-left; }
.pn-flow-label { color: rgb(53,69,77); font-size: 17px; margin: 3px 0; white-space: normal; }
.pn-flow-hint { color: rgb(88,104,112); font-size: 15px; margin: 6px 0 10px 0; white-space: normal; }
.pn-flow-button { height: 52px; min-height: 52px; margin: 6px 0; border-width: 1px; border-color: rgba(255,255,255,0.7); border-radius: 16px; background-color: rgb(240,243,244); color: rgb(53,69,77); font-size: 18px; -unity-text-align: middle-left; padding-left: 18px; }
.pn-flow-button:hover { background-color: white; }
.pn-flow-button:active { background-color: rgb(231,238,240); }
.pn-flow-button:focus { border-color: white; }
.pn-flow-button:disabled { color: rgb(146,157,162); background-color: rgb(240,243,244); opacity: 1; }
.pn-flow-field { margin: 6px 0; }
.pn-address-field { height: 64px; min-height: 64px; margin: 9px 0; }
.pn-address-field .unity-base-text-field__input { height: 64px; margin: 0; padding: 19px 24px 0 24px; border-width: 1px; border-color: rgba(255,255,255,0.7); border-radius: 17px; background-color: rgb(248,250,250); color: rgb(53,69,77); font-size: 20px; -unity-text-align: upper-left; }
.pn-address-field:focus .unity-base-text-field__input { border-color: white; background-color: white; }
.pn-address-field .unity-base-text-field__input--placeholder { color: rgb(146,157,162); }
.pn-flow-field .unity-base-field__label { color: rgb(53,69,77); font-size: 16px; min-width: 110px; }
.pn-room-list { max-height: 220px; margin-bottom: 4px; }
.pn-flow-toast { position: absolute; left: 50%; top: 24px; translate: -50% 0; max-width: 80%; }
.pn-flow-toast .pn-flow-label { color: white; text-shadow: 0 1px 3px rgba(0,0,0,0.6); font-size: 18px; }
.pn-room-text { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: rgb(53,69,77); font-size: 20px; -unity-text-align: middle-left; }
.pause-choice:disabled .pn-room-text { color: rgb(146,157,162); }
.pn-settings-view { overflow: hidden; color: white; }
.pn-settings-rows { position: absolute; }
.pn-settings-row { flex-direction: row; align-items: center; height: 58px; flex-shrink: 0; margin-bottom: 26px; }
.pn-settings-label { width: 180px; flex-shrink: 0; margin-right: 32px; font-size: 23px; color: white; -unity-text-align: middle-left; text-shadow: 0 1px 4px rgba(53,70,80,.45); }
.pn-settings-row-narrow .pn-settings-label { width: 31%; margin-right: 18px; font-size: 21px; }
.pn-settings-trigger { flex-grow: 1; flex-shrink: 1; height: 58px; min-width: 170px; flex-direction: row; align-items: center; justify-content: space-between; padding-left: 22px; padding-right: 22px; margin: 0; border-radius: 17px; border-width: 1px; border-color: white; background-color: rgba(243,246,247,.95); color: rgb(53,70,80); }
.pn-settings-trigger:hover { background-color: white; }
.pn-settings-trigger:focus { border-color: rgb(224,241,252); border-width: 2px; }
.pn-settings-value { flex-grow: 1; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 21px; -unity-text-align: middle-left; }
.pn-settings-chevron { width: 18px; height: 18px; flex-shrink: 0; }
.pn-settings-options { position: absolute; padding: 6px; border-radius: 17px; border-width: 1px; border-color: rgba(255,255,255,.5); background-color: rgba(137,151,159,.97); transform-origin: top center; }
.pn-settings-scroll { flex-grow: 1; }
.pn-settings-option { height: 46px; flex-shrink: 0; margin: 0 7px 0 0; padding-left: 15px; padding-right: 15px; border-width: 0; border-radius: 11px; background-color: transparent; color: white; font-size: 20px; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pn-settings-option:hover, .pn-settings-option:focus { background-color: rgba(255,255,255,.15); }
.pn-settings-option-selected { background-color: rgba(255,255,255,.11); }
.pn-settings-error { color: rgb(136,62,62); font-size: 17px; white-space: normal; }

/* Section settings: transparent groups, two columns within each vertical section. */
.pn-settings-rows > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-right: 6px; }
.pn-settings-section { margin-bottom: 46px; flex-shrink: 0; }
.pn-settings-heading { align-items: flex-start; margin-bottom: 24px; flex-shrink: 0; }
.pn-settings-heading > Label { font-size: 24px; height: 32px; margin: 0; padding: 0; color: white; -unity-font-style: normal; text-shadow: 0 1px 4px rgba(53,70,80,.35); }
.pn-settings-heading-line { position: absolute; left: 0; height: 3px; bottom: -7px; }
.pn-settings-fields { flex-direction: row; flex-wrap: wrap; }
.pn-settings-row { height: 52px; margin-bottom: 24px; }
.pn-settings-label { width: 145px; margin-right: 18px; font-size: 19px; white-space: normal; }
.pn-settings-row-narrow .pn-settings-label { width: 34%; margin-right: 18px; font-size: 18px; }
.pn-settings-trigger { height: 52px; min-width: 0; padding-left: 18px; padding-right: 18px; }
.pn-settings-value { font-size: 20px; }
.pn-settings-divider { height: 20px; width: 76%; max-width: 650px; align-self: center; margin-bottom: 36px; flex-shrink: 0; }

.pn-settings-rows .unity-base-slider__dragger, .pn-settings-scroll .unity-base-slider__dragger { background-color: white; }

/* Settings: one Save at the end of the list, the locked-look reason, the discard confirmation. */
.pn-settings-reason { color: rgb(53,70,80); font-size: 16px; white-space: normal; margin-top: -12px; margin-bottom: 16px; }
.pn-settings-save-row { flex-direction: row; align-items: center; height: 52px; flex-shrink: 0; margin-top: 8px; margin-bottom: 40px; }
.pn-settings-save { height: 52px; min-width: 170px; padding-left: 26px; padding-right: 26px; margin: 0 18px 0 0; border-radius: 17px; border-width: 1px; border-color: white; background-color: rgba(243,246,247,.95); color: rgb(53,70,80); font-size: 20px; }
.pn-settings-save:hover { background-color: white; }
.pn-settings-save:disabled { background-color: rgba(243,246,247,.45); color: rgba(53,70,80,.5); }
.pn-settings-save-status { color: white; font-size: 17px; text-shadow: 0 1px 4px rgba(53,70,80,.45); white-space: normal; flex-shrink: 1; }
.pn-settings-confirm { position: absolute; left: 50%; top: 50%; translate: -50% -50%; max-width: 80%; padding: 22px 26px; border-radius: 22px; border-width: 1px; border-color: rgba(255,255,255,.6); background-color: rgba(137,151,159,.97); align-items: center; }
.pn-settings-confirm-text { color: white; font-size: 21px; white-space: normal; -unity-text-align: middle-center; margin-bottom: 18px; }
.pn-settings-confirm-row { flex-direction: row; justify-content: center; }
